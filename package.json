{
  "name": "fmkorea-hotdeal-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "FMKorea hotdeal monitor with Slack and Telegram alerts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:k8s": "node dist/entrypoints/k8s.js",
    "dev": "tsx watch src/index.ts",
    "run:local": "bash scripts/run-local.sh",
    "run:once:local": "bash scripts/run-keyword-once-local.sh",
    "run:once:docker": "bash scripts/run-keyword-once-docker.sh",
    "docker:test": "bash scripts/run-docker.sh",
    "docker:build": "docker build -t fmkorea-hotdeal-monitor:test .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.js && TZ=Asia/Seoul node --test tests/kst/*.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@kubernetes/client-node": "^2.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.4",
    "@sparticuz/chromium-min": "^153.0.0",
    "playwright-core": "^1.63.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
